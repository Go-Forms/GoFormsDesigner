{
  "name": "goforms-designer",
  "displayName": "GoForms Designer",
  "description": "Visual WinForms-style designer for GoForms: drag-and-drop editing of *-designer.go files, plus project/form scaffolding commands.",
  "version": "0.10.1",
  "publisher": "goforms",
  "license": "MIT",
  "icon": "media/icon.png",
  "homepage": "https://go-forms.github.io/GoForms/",
  "repository": {
    "type": "git",
    "url": "https://github.com/Go-Forms/GoFormsDesigner.git"
  },
  "bugs": {
    "url": "https://github.com/Go-Forms/GoFormsDesigner/issues"
  },
  "qna": "https://github.com/Go-Forms/GoFormsDesigner/issues",
  "galleryBanner": {
    "color": "#0f172a",
    "theme": "dark"
  },
  "keywords": [
    "go",
    "golang",
    "winforms",
    "gui",
    "designer",
    "form designer",
    "drag and drop",
    "fyne",
    "desktop"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Visualization",
    "Other"
  ],
  "activationEvents": [
    "onLanguage:go"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "goforms.themeEditor",
        "displayName": "GoForms Theme",
        "selector": [
          {
            "filenamePattern": "*-styles.go"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "goforms.designer",
        "displayName": "GoForms Designer",
        "selector": [
          {
            "filenamePattern": "*-designer.go"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "goforms.createProject",
        "title": "GoForms: Create New Project...",
        "category": "GoForms"
      },
      {
        "command": "goforms.newForm",
        "title": "GoForms: New Form...",
        "category": "GoForms"
      },
      {
        "command": "goforms.openDesigner",
        "title": "GoForms: Open Visual Designer",
        "category": "GoForms",
        "icon": "$(layout)"
      },
      {
        "command": "goforms.openAsText",
        "title": "GoForms: Open as Text",
        "category": "GoForms",
        "icon": "$(code)"
      },
      {
        "command": "goforms.setFrameworkPath",
        "title": "GoForms: Set Framework Path...",
        "category": "GoForms"
      },
      {
        "command": "goforms.tidyDesignerFile",
        "title": "GoForms: Tidy Designer File",
        "category": "GoForms",
        "icon": "$(sparkle)"
      },
      {
        "command": "goforms.checkSetup",
        "title": "GoForms: Check Setup",
        "category": "GoForms"
      },
      {
        "command": "goforms.editTheme",
        "title": "GoForms: Edit Theme",
        "category": "GoForms",
        "icon": "$(symbol-color)"
      },
      {
        "command": "goforms.openThemeAsText",
        "title": "GoForms: Open Theme as Text",
        "category": "GoForms",
        "icon": "$(code)"
      },
      {
        "command": "goforms.build",
        "title": "GoForms: Build...",
        "category": "GoForms",
        "icon": "$(package)"
      },
      {
        "command": "goforms.buildDesktop",
        "title": "GoForms: Build for Desktop",
        "category": "GoForms"
      },
      {
        "command": "goforms.runDesktop",
        "title": "GoForms: Run on Desktop",
        "category": "GoForms",
        "icon": "$(play)"
      },
      {
        "command": "goforms.buildWasm",
        "title": "GoForms: Build for WebAssembly",
        "category": "GoForms"
      },
      {
        "command": "goforms.serveWasm",
        "title": "GoForms: Serve WebAssembly Build in Browser",
        "category": "GoForms"
      },
      {
        "command": "goforms.buildAndroid",
        "title": "GoForms: Build for Android (APK)",
        "category": "GoForms"
      },
      {
        "command": "goforms.installAndroid",
        "title": "GoForms: Install APK on Connected Device (adb)",
        "category": "GoForms"
      },
      {
        "command": "goforms.setAndroidNdkPath",
        "title": "GoForms: Set Android NDK Path...",
        "category": "GoForms"
      },
      {
        "command": "goforms.setFynePath",
        "title": "GoForms: Set fyne CLI Path...",
        "category": "GoForms"
      },
      {
        "command": "goforms.openSetupGuide",
        "title": "GoForms: Open Setup Guide (Android NDK, fyne CLI, WebAssembly)",
        "category": "GoForms"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "goforms.newForm",
          "when": "explorerResourceIsFolder",
          "group": "goforms@1"
        },
        {
          "command": "goforms.build",
          "when": "resourceFilename == go.mod",
          "group": "goforms@2"
        },
        {
          "command": "goforms.runDesktop",
          "when": "resourceFilename == go.mod",
          "group": "goforms@3"
        }
      ],
      "commandPalette": [
        {
          "command": "goforms.createProject"
        },
        {
          "command": "goforms.newForm"
        },
        {
          "command": "goforms.openDesigner",
          "when": "resourceFilename =~ /-designer\\.go$/"
        },
        {
          "command": "goforms.openAsText",
          "when": "resourceFilename =~ /-designer\\.go$/"
        },
        {
          "command": "goforms.setFrameworkPath"
        },
        {
          "command": "goforms.checkSetup"
        },
        {
          "command": "goforms.editTheme"
        },
        {
          "command": "goforms.openThemeAsText",
          "when": "resourceFilename =~ /-styles\\.go$/"
        },
        {
          "command": "goforms.tidyDesignerFile",
          "when": "resourceFilename =~ /-designer\\.go$/"
        },
        {
          "command": "goforms.build"
        },
        {
          "command": "goforms.buildDesktop"
        },
        {
          "command": "goforms.runDesktop"
        },
        {
          "command": "goforms.buildWasm"
        },
        {
          "command": "goforms.serveWasm"
        },
        {
          "command": "goforms.buildAndroid"
        },
        {
          "command": "goforms.installAndroid"
        },
        {
          "command": "goforms.setAndroidNdkPath"
        },
        {
          "command": "goforms.setFynePath"
        },
        {
          "command": "goforms.openSetupGuide"
        }
      ],
      "editor/title": [
        {
          "command": "goforms.openThemeAsText",
          "when": "activeCustomEditorId == 'goforms.themeEditor'",
          "group": "navigation"
        },
        {
          "command": "goforms.editTheme",
          "when": "resourceFilename =~ /-styles\\.go$/ && activeCustomEditorId != 'goforms.themeEditor'",
          "group": "navigation"
        },
        {
          "command": "goforms.tidyDesignerFile",
          "when": "resourceFilename =~ /-designer\\.go$/",
          "group": "navigation@3"
        },
        {
          "command": "goforms.openAsText",
          "when": "activeCustomEditorId == 'goforms.designer'",
          "group": "navigation"
        },
        {
          "command": "goforms.openDesigner",
          "when": "resourceFilename =~ /-designer\\.go$/ && activeCustomEditorId != 'goforms.designer'",
          "group": "navigation"
        },
        {
          "command": "goforms.runDesktop",
          "when": "activeCustomEditorId == 'goforms.designer'",
          "group": "navigation@1"
        },
        {
          "command": "goforms.build",
          "when": "activeCustomEditorId == 'goforms.designer'",
          "group": "navigation@2"
        }
      ]
    },
    "configuration": {
      "title": "GoForms Designer",
      "properties": {
        "goforms.goPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Full path to the `go` executable, for when the editor cannot find one itself. A GUI editor inherits the desktop session's `PATH`, not the one your `.bashrc`/`.zshrc` builds, so a Go installed under `/usr/local/go/bin` or managed by asdf/mise is often invisible to it even though it works in your terminal. Leave empty to search `goforms.goPath`, `go.goroot`, `GOROOT`, `PATH`, and the usual install locations, in that order."
        },
        "goforms.frameworkPath": {
          "type": "string",
          "default": "",
          "description": "Absolute path to a local GoForms checkout (the folder containing go.mod for the goforms module). Used as the `replace goforms => ...` target when scaffolding new projects. Leave empty to be prompted the first time it's needed."
        },
        "goforms.fynePath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Full path to the `fyne` command-line tool (`go install fyne.io/tools/cmd/fyne@latest` puts it in `$(go env GOPATH)/bin`). Needed only for Android builds. Leave empty to search `PATH` and the Go bin directory."
        },
        "goforms.androidNdkPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path to the Android NDK root (the folder containing `source.properties` and `toolchains/`). Leave empty to search `ANDROID_NDK_HOME`, `ANDROID_HOME/ndk/*`, `~/Android/android-ndk-*`, `C:\\\\android-ndk-*` and the other usual places. `GoForms: Open Setup Guide` explains where to put a downloaded NDK."
        },
        "goforms.android.target": {
          "type": "string",
          "default": "android/arm64",
          "enum": [
            "android/arm64",
            "android/arm",
            "android/amd64",
            "android/386",
            "android"
          ],
          "enumDescriptions": [
            "64-bit ARM: every phone made since about 2015 - the fastest build and the smallest APK",
            "32-bit ARM: old phones",
            "x86-64: the Android emulator on a PC",
            "x86: very old emulators",
            "Every architecture in one APK - four times the size and the build time"
          ],
          "markdownDescription": "Which Android architecture `GoForms: Build for Android` packages. One APK per build; pick `android` for all four."
        },
        "goforms.build.offline": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Run builds with `GOPROXY=off`, so a module missing from the local cache fails immediately by name rather than waiting on a download. Builds never need the network as long as `go mod download` has run once; turn this on to have that verified rather than assumed."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --target=node18",
    "watch": "npm run build -- --watch",
    "package": "vsce package",
    "test": "node --test"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.20.0",
    "typescript": "^5.4.0",
    "@vscode/vsce": "^2.24.0"
  }
}
